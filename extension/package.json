{
  "name": "smartorch",
  "displayName": "SmartOrch — IA local",
  "description": "Chat, autocompletado y agente con modelos locales (Ollama) y RAG sobre tu proyecto. Tu código no sale de tu máquina.",
  "version": "2.1.0",
  "publisher": "smartorch",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "ollama",
    "local",
    "copilot",
    "chat",
    "autocomplete",
    "agent",
    "llm",
    "offline",
    "privacy"
  ],
  "icon": "media/smartorch-icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DARKTOTEM2703/smartorch"
  },
  "homepage": "https://github.com/DARKTOTEM2703/smartorch#readme",
  "bugs": {
    "url": "https://github.com/DARKTOTEM2703/smartorch/issues"
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smartorch",
          "title": "SmartOrch",
          "icon": "media/icons/smartorch-activity.svg"
        }
      ]
    },
    "views": {
      "smartorch": [
        {
          "type": "webview",
          "id": "smartorch.chatView",
          "name": "Chat"
        },
        {
          "id": "smartorch.conversationsView",
          "name": "Historial"
        },
        {
          "id": "smartorch.projectView",
          "name": "Proyecto"
        }
      ]
    },
    "commands": [
      {
        "command": "smartorch.openChat",
        "title": "Abrir chat",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.openChatTab",
        "title": "Abrir chat en una pestaña",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.explain",
        "title": "/explain — Explicar código",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.fix",
        "title": "/fix — Corregir bugs",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.refactor",
        "title": "/refactor — Refactorizar",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.solid",
        "title": "/solid — Aplicar SOLID/DRY",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.review",
        "title": "/review — Code review",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.test",
        "title": "/test — Generar tests",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.docstring",
        "title": "/doc — Generar documentación",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.optimize",
        "title": "/optimize — Optimizar rendimiento",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.yara",
        "title": "/yara — Generar regla YARA",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.sigma",
        "title": "/sigma — Generar regla Sigma",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.c2",
        "title": "/c2 — Analizar C2/malware",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.pentest",
        "title": "/pentest — Guía de pentest",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.web",
        "title": "/web — Feature web",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.mobile",
        "title": "/mobile — Feature mobile",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.onboarding",
        "title": "Configuración inicial",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.startServer",
        "title": "Iniciar servidor",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.status",
        "title": "Ver estado del servidor",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.indexWorkspace",
        "title": "Indexar workspace (RAG)",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.terminalChat",
        "title": "Chat en terminal",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.openWeb",
        "title": "Abrir la web de SmartOrch",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.sendToWeb",
        "title": "Enviar archivo o selección a la web",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.conversations",
        "title": "Conversaciones compartidas (web · terminal · VS Code)",
        "category": "SmartOrch"
      },
      {
        "command": "smartorch.analyzeProject",
        "title": "Analizar proyecto",
        "category": "SmartOrch",
        "icon": "$(graph)"
      },
      {
        "command": "smartorch.refreshViews",
        "title": "Actualizar historial y proyecto",
        "category": "SmartOrch",
        "icon": "$(refresh)"
      },
      {
        "command": "smartorch.renameConversation",
        "title": "Renombrar conversación",
        "category": "SmartOrch",
        "icon": "$(edit)"
      },
      {
        "command": "smartorch.deleteConversation",
        "title": "Eliminar conversación",
        "category": "SmartOrch",
        "icon": "$(trash)"
      }
    ],
    "submenus": [
      {
        "id": "smartorch.contextMenu",
        "label": "⚡ SmartOrch"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "smartorch.contextMenu",
          "group": "0_smartorch",
          "when": "editorTextFocus"
        }
      ],
      "smartorch.contextMenu": [
        {
          "command": "smartorch.explain",
          "group": "1_clean@1",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.fix",
          "group": "1_clean@2",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.refactor",
          "group": "1_clean@3",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.solid",
          "group": "1_clean@4",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.review",
          "group": "1_clean@5",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.test",
          "group": "1_clean@6",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.docstring",
          "group": "1_clean@7",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.optimize",
          "group": "1_clean@8",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.yara",
          "group": "2_sec@1",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.sigma",
          "group": "2_sec@2",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.c2",
          "group": "2_sec@3",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.pentest",
          "group": "2_sec@4",
          "when": "editorHasSelection"
        },
        {
          "command": "smartorch.web",
          "group": "3_stack@1"
        },
        {
          "command": "smartorch.mobile",
          "group": "3_stack@2"
        },
        {
          "command": "smartorch.sendToWeb",
          "group": "4_bridge@1"
        }
      ],
      "view/title": [
        {
          "command": "smartorch.refreshViews",
          "when": "view == smartorch.conversationsView || view == smartorch.projectView",
          "group": "navigation"
        },
        {
          "command": "smartorch.analyzeProject",
          "when": "view == smartorch.projectView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "smartorch.renameConversation",
          "when": "view == smartorch.conversationsView && viewItem == conversation",
          "group": "inline@1"
        },
        {
          "command": "smartorch.deleteConversation",
          "when": "view == smartorch.conversationsView && viewItem == conversation",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "smartorch.renameConversation",
          "when": "false"
        },
        {
          "command": "smartorch.deleteConversation",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "smartorch.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "smartorch.explain",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      },
      {
        "command": "smartorch.review",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "SmartOrch",
      "properties": {
        "smartorch.apiUrl": {
          "type": "string",
          "default": "http://localhost:8080/v1",
          "description": "URL del servidor SmartOrch."
        },
        "smartorch.apiKey": {
          "type": "string",
          "default": "smartorch-local-key",
          "description": "API key del servidor SmartOrch (SMARTORCH_API_KEY)."
        },
        "smartorch.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "native",
            "wsl",
            "docker",
            "remote"
          ],
          "default": "auto",
          "description": "Dónde corre el servidor: nativo (Windows/Linux/macOS), WSL, Docker o remoto. Se elige en 'SmartOrch: Configuración inicial'."
        },
        "smartorch.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Iniciar el servidor SmartOrch automáticamente al abrir VS Code."
        },
        "smartorch.serverPath": {
          "type": "string",
          "default": "",
          "description": "Opcional: ruta a run.py del servidor. Vacío = se busca el comando `smartorch`, la carpeta del workspace o el paquete Python instalado."
        },
        "smartorch.ollamaModelsPath": {
          "type": "string",
          "default": "",
          "description": "Carpeta donde Ollama guarda los modelos (OLLAMA_MODELS). Vacío = la de por defecto. Se cambia desde la configuración inicial."
        },
        "smartorch.ollamaPath": {
          "type": "string",
          "default": "",
          "description": "Ruta al ejecutable de Ollama. Vacío = el que está en el PATH."
        },
        "smartorch.autocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar autocompletado en línea."
        },
        "smartorch.autocompleteDelay": {
          "type": "number",
          "default": 400,
          "description": "Milisegundos de pausa al escribir antes de pedir una sugerencia."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "smartorch.conversationsView",
        "contents": "Aún no hay conversaciones, o el servidor está apagado.\n[Iniciar servidor](command:smartorch.startServer)"
      },
      {
        "view": "smartorch.projectView",
        "contents": "Abre una carpeta y deja que SmartOrch la analice.\n[Analizar proyecto](command:smartorch.analyzeProject)"
      }
    ]
  },
  "scripts": {
    "sync-ui": "node scripts/sync-ui.js",
    "compile": "node scripts/clean.js && node scripts/sync-ui.js && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
